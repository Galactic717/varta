# VARTA — приклад налаштувань. Скопіюйте у `.env` поруч із main.py і змініть потрібне.

# Адреса сервера. 127.0.0.1 — лише цей ПК; 0.0.0.0 — доступ з мережі (тоді потрібен HTTPS-проксі,
# інакше браузер не дасть геолокацію і сповіщення).
VARTA_HOST=127.0.0.1
VARTA_PORT=8080

# 0 — не опитувати MAPA.UA (лише NEPTUN)
VARTA_MAPA=1

# 1 — не підключатися до джерел (тести, демо)
VARTA_OFFLINE=0

# 1 — писати фрейми NEPTUN у data/log (власний архів, ~1–2 МБ на добу)
VARTA_LOG_EVENTS=1

# Класифікатор наміру: intent (mmBERT, потрібні torch + transformers) або intent_ngram (легкий, без torch)
VARTA_MODEL=intent

# Місце за замовчуванням для `python main.py ask` (широта,довгота,назва)
# VARTA_HOME=50.4501,30.5234,Дім
